\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Historical stETH/ETH replay (selected rows). Shortfall is scenario-scale dollars on a modeled 100-unit position. The \emph  {PegShield LTV} column reports the running minimum (most conservative LTV reached to date) that the modeled borrower follows, which is why it remains at the $40\%$ floor on \texttt  {NORMAL} rows after a prior \texttt  {CRITICAL} signal; consequently the PegShield shortfall is an \emph  {upper bound} on the timing benefit rather than a per-slot causal measurement (see Section~\ref {sec:discussion}).}}{9}{table.4}\protected@file@percent }
\newlabel{tab:replay}{{IV}{9}{Historical stETH/ETH replay (selected rows). Shortfall is scenario-scale dollars on a modeled 100-unit position. The \emph {PegShield LTV} column reports the running minimum (most conservative LTV reached to date) that the modeled borrower follows, which is why it remains at the $40\%$ floor on \texttt {NORMAL} rows after a prior \texttt {CRITICAL} signal; consequently the PegShield shortfall is an \emph {upper bound} on the timing benefit rather than a per-slot causal measurement (see Section~\ref {sec:discussion})}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {V}{\ignorespaces Stress-suite results (one historical replay and eight synthetic paths) on the modeled 100-unit position. ``Static shortfall'' and ``PegShield shortfall'' are peak modeled dollars under the fixed-80\% baseline and under PegShield; ``Critical rows'' counts rows flagged \texttt  {CRITICAL} by Eq.~\eqref  {eq:critical}; ``Recovered'' indicates the regime returned to monitoring rather than remaining latched at the floor. Synthetic paths are regression tests for the policy surface, not empirical market measurements.}}{9}{table.5}\protected@file@percent }
\newlabel{tab:scenarios}{{V}{9}{Stress-suite results (one historical replay and eight synthetic paths) on the modeled 100-unit position. ``Static shortfall'' and ``PegShield shortfall'' are peak modeled dollars under the fixed-80\% baseline and under PegShield; ``Critical rows'' counts rows flagged \texttt {CRITICAL} by Eq.~\eqref {eq:critical}; ``Recovered'' indicates the regime returned to monitoring rather than remaining latched at the floor. Synthetic paths are regression tests for the policy surface, not empirical market measurements}{table.5}{}}
